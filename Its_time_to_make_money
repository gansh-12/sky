//public/expense_script.js
function addExpense(e) {
    e.preventDefault();
    
    const expense={
        amount:parseInt(e.target.amount.value),
        description:e.target.description.value,
        category:e.target.category.value,
        userId:localStorage.getItem("userId")
    }
    
    axios.post('http://localhost:3000/expense', expense).then(res=> {
        showExpenseOnScreen(res.data);
        e.target.reset();
    }).catch(err=> {
        alert("Error adding expense: "+err.message);
    })
}

function showExpenseOnScreen(expense) {
    const parent=document.getElementById('expenseList');
    const li=document.createElement('li');
    li.textContent=`${expense.amount} - ${expense.description} - ${expense.category}`;
    
    const deleteBtn=document.createElement('button');
    deleteBtn.textContent='Delete';
    deleteBtn.onclick=()=> {
        axios.delete(`http://localhost:3000/expense/${expense.id}`).then(()=> {
            li.remove();
        }).catch(err=> {
            console.log("Error deleting expense:",err);
            alert("Error deleting expense");
        })
    }
    
    li.appendChild(deleteBtn);
    parent.appendChild(li);
}

window.addEventListener('DOMContentLoaded', ()=> {
    const userId=localStorage.getItem("userId");
    axios.get(`http://localhost:3000/expenses?userId=${userId}`).then(res=> {
        res.data.forEach(exp => {
            showExpenseOnScreen(exp)
        });
    }).catch(err=> {
        console.log("Error loading expenses: ", err);
    })
})


